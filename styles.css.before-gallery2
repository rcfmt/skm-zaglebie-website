/* ===== SKM airfield Google Map ===== */

.contact-map-wrap {
  margin-top: 70px;
}

.contact-map-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 24px;
}

.contact-map-header .eyebrow {
  margin-bottom: 10px;
}

.contact-map-header h3 {
  margin: 0;
  color: #fff;
  font-family: "Barlow Condensed", sans-serif;
  font-size: clamp(2rem, 4vw, 3.4rem);
  line-height: 1;
  text-transform: uppercase;
}

.map-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex: 0 0 auto;
  padding: 13px 20px;
  border: 1px solid rgba(255,255,255,.22);
  border-radius: 999px;
  background: rgba(255,255,255,.06);
  color: #fff;
  font-size: .88rem;
  font-weight: 700;
  transition: background .2s ease, border-color .2s ease, transform .2s ease;
}

.map-link:hover {
  transform: translateY(-2px);
  border-color: var(--orange);
  background: rgba(255,255,255,.11);
}

.map-link span {
  color: var(--orange);
}

.contact-map {
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 26px;
  background: rgba(255,255,255,.05);
  box-shadow: 0 25px 70px rgba(0,0,0,.22);
}

.contact-map iframe {
  display: block;
  width: 100%;
  height: 480px;
  border: 0;
}

@media (max-width: 650px) {
  .contact-map-wrap {
    margin-top: 50px;
  }

  .contact-map-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .contact-map iframe {
    height: 360px;
  }
}


/* ===== SKM Facebook Gallery ===== */

.gallery-section {
  background: var(--cream);
}

.gallery-heading > p {
  max-width: 490px;
  color: var(--muted);
}

.facebook-gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.gallery-card {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #fff;
  box-shadow: 0 12px 35px rgba(7,20,38,.08);
}

.gallery-card img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .3s ease;
}

.gallery-card:hover img {
  transform: scale(1.04);
}

.gallery-status {
  grid-column: 1 / -1;
  display: grid;
  gap: 9px;
  min-height: 260px;
  place-content: center;
  padding: 40px;
  border: 1px dashed rgba(7,20,38,.22);
  border-radius: var(--radius);
  background: rgba(255,255,255,.65);
  text-align: center;
}

.gallery-status strong {
  color: var(--navy);
  font-family: "Barlow Condensed", sans-serif;
  font-size: 2.2rem;
  line-height: 1;
  text-transform: uppercase;
}

.gallery-status span {
  color: var(--muted);
}

.gallery-actions {
  display: flex;
  justify-content: center;
  margin-top: 34px;
}

@media (max-width: 900px) {
  .facebook-gallery {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 560px) {
  .facebook-gallery {
    grid-template-columns: 1fr;
  }

  .gallery-card {
    aspect-ratio: 16 / 11;
  }
}
